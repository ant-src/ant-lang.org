// Errors are values. A function that can fail returns a Result,
// try returns early with its error, and wrapErr says where it happened.

type Config = { host: string, port: int }

func parsePort(text: string): Result[int, Error] {
  let port = text.toInt() ?? return Result.fail("\"${text}\" is not a number")
  if port < 1 || port > 65535 {
    return Result.fail("${port} is not a port")
  }
  Result.ok(port)
}

func parseConfig(text: string): Result[Config, Error] {
  let config = Config{ host: "localhost", port: 8080 }
  for { index, value } in text.lines().entries() {
    let parts = value.split("=")
    if parts.length() != 2 {
      return Result.fail("line ${index + 1}: expected key=value")
    }
    let key = parts[0].trim()
    if key == "host" {
      config.host = parts[1].trim()
    } else if key == "port" {
      config.port = try (parsePort(parts[1].trim()) | Result.wrapErr("line ${index + 1}: port"))
    } else {
      return Result.fail("line ${index + 1}: unknown key ${key}")
    }
  }
  Result.ok(config)
}

for text in ["host = ant-lang.org\nport = 443", "port = eighty", "port = 70000", "colour = red"] {
  let config = parseConfig(text)
  if config is Ok {
    println("ok: ${config.value.host}:${config.value.port}")
  } else {
    println("error: ${config.error.message}")
  }
}
