// A calculator: a tokenizer, a parser into a union of records, and an evaluator.
// Each string at the end is an expression. Edit them, and Run.

type Num = { value: float64 }
type Ident = { name: string }
type Punct = { text: string }
type Token = Num | Ident | Punct

type Lit = { value: float64 }
type Ref = { name: string }
type Neg = { operand: Expr }
type Bin = { op: string, left: Expr, right: Expr }
type Expr = Lit | Ref | Neg | Bin

func isNumberChar(ch: string): bool { ch.isDigit() || ch == "." }

func tokenize(src: string): Result[Array[Token], Error] {
  let tokens: Array[Token] = []
  let chars = src.chars()
  var i = 0
  while i < chars.length() {
    let ch = chars[i]
    let start = i
    if ch == " " {
      i += 1
    } else if isNumberChar(ch) {
      while i < chars.length() && isNumberChar(chars[i]) { i += 1 }
      let text = String.join(chars.slice(start, i), "")
      let value = text.toFloat() ?? return Result.fail("bad number ${text}")
      tokens.push(Num{ value })
    } else if ch.isLetter() {
      while i < chars.length() && chars[i].isLetter() { i += 1 }
      tokens.push(Ident{ name: String.join(chars.slice(start, i), "") })
    } else if "+-*/()".contains(ch) {
      tokens.push(Punct{ text: ch })
      i += 1
    } else {
      return Result.fail("unexpected character ${ch} at ${i}")
    }
  }
  Result.ok(tokens)
}

type Parser = { tokens: Array[Token], pos: int }

func Parser.peek(p: Parser): Token | null { p.tokens.get(p.pos) }

func Parser.next(p: Parser): Token | null {
  let token = p.peek()
  p.pos += 1
  token
}

// accept takes the next token when it is one of the operators, and gives its text.
func Parser.accept(p: Parser, operators: string): string | null {
  let token = p.peek()
  if token is Punct && operators.contains(token.text) {
    p.pos += 1
    return token.text
  }
  null
}

// expr := term (("+" | "-") term)*
func Parser.expr(p: Parser): Result[Expr, Error] {
  var left = try p.term()
  while true {
    let op = p.accept("+-") ?? return Result.ok(left)
    left = Bin{ op, left, right: try p.term() }
  }
}

// term := unary (("*" | "/") unary)*
func Parser.term(p: Parser): Result[Expr, Error] {
  var left = try p.unary()
  while true {
    let op = p.accept("*/") ?? return Result.ok(left)
    left = Bin{ op, left, right: try p.unary() }
  }
}

// unary := "-" unary | primary
func Parser.unary(p: Parser): Result[Expr, Error] {
  if p.accept("-") != null {
    return Result.ok(Neg{ operand: try p.unary() })
  }
  p.primary()
}

// primary := number | name | "(" expr ")"
func Parser.primary(p: Parser): Result[Expr, Error] {
  let token = p.next() ?? return Result.fail("unexpected end of input")
  if token is Num { return Result.ok(Lit{ value: token.value }) }
  if token is Ident { return Result.ok(Ref{ name: token.name }) }
  if token.text != "(" { return Result.fail("unexpected ${token.text}") }
  let inner = try p.expr()
  if p.accept(")") == null { return Result.fail("expected )") }
  Result.ok(inner)
}

func parse(src: string): Result[Expr, Error] {
  let p = Parser{ tokens: try tokenize(src), pos: 0 }
  let e = try p.expr()
  let rest = p.peek()
  if rest != null { return Result.fail("unexpected ${show(rest)} after the expression") }
  Result.ok(e)
}

func show(t: Token): string {
  if t is Num { String.from(t.value) } else if t is Ident { t.name } else { t.text }
}

func eval(e: Expr, env: Map[string, float64]): Result[float64, Error] {
  if e is Lit { return Result.ok(e.value) }
  if e is Ref {
    let value = env[e.name] ?? return Result.fail("unknown variable ${e.name}")
    return Result.ok(value)
  }
  if e is Neg { return Result.ok(-(try eval(e.operand, env))) }
  let l = try eval(e.left, env)
  let r = try eval(e.right, env)
  if e.op == "+" { Result.ok(l + r) }
  else if e.op == "-" { Result.ok(l - r) }
  else if e.op == "*" { Result.ok(l * r) }
  else if r == 0.0 { Result.fail("division by zero") }
  else { Result.ok(l / r) }
}

func format(e: Expr): string {
  if e is Lit { String.from(e.value) }
  else if e is Ref { e.name }
  else if e is Neg { "(-${format(e.operand)})" }
  else { "(${format(e.left)} ${e.op} ${format(e.right)})" }
}

func calculate(src: string, env: Map[string, float64]): string {
  let parsed = parse(src)
  if parsed is Err { return "${src} => error: ${parsed.error.message}" }
  let result = eval(parsed.value, env)
  if result is Err { return "${format(parsed.value)} => error: ${result.error.message}" }
  "${format(parsed.value)} => ${result.value}"
}

let env = Map{ pi: 3.141592653589793, e: 2.718281828459045 }
for src in ["1 + 2 * pi", "(1 + 2) * pi", "-e / 0", "x + 1", "2 * (3 + 4", "7 % 2"] {
  println(calculate(src, env))
}
