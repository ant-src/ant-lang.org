// A pipe passes the value on its left as the first argument on its right.
// { x.paid } is a lambda; x is its parameter.

type Order = { customer: string, total: int, paid: bool }
type Spend = { customer: string, orders: int, total: int }

let orders = [
  Order{ customer: "Ada", total: 120, paid: true },
  Order{ customer: "Linus", total: 45, paid: true },
  Order{ customer: "Ada", total: 80, paid: false },
  Order{ customer: "Grace", total: 210, paid: true },
  Order{ customer: "Linus", total: 60, paid: true },
  Order{ customer: "Ada", total: 35, paid: true },
]

func spend(e: Entry[string, Array[Order]]): Spend {
  Spend{ customer: e.key, orders: e.value.length(), total: e.value.map({ x.total }).sum() ?? 0 }
}

// Paid orders, by customer, biggest spender first.
let spenders = orders
  | Array.filter({ x.paid })
  | Array.groupBy({ x.customer })
  | Map.entries()
  | Array.map(spend)
  | Array.sortBy({ -x.total })

for s in spenders {
  println("${s.customer.padEnd(6)} ${s.orders} paid, ${s.total} in all")
}
