// Parallel runs work on goroutines and waits for it. go starts one by hand,
// channels carry values between them, and select waits for whichever is ready first.

func countPrimes(from: int, work: Context): int {
  var count = 0
  for n in Iter.range(from, from + 5000) {
    var prime = n > 1
    var d = 2
    while prime && d * d <= n {
      prime = n % d != 0
      d += 1
    }
    if prime { count += 1 }
  }
  count
}

// Four ranges, counted at the same time; the results come back in order.
let counts = Parallel.map([0, 5000, 10000, 15000], countPrimes, limit: 4) ?? []
println("primes in each quarter: ${counts}")
println("primes below 20000: ${counts.sum() ?? 0}")

// A pipeline: one goroutine sends words, the main one receives them.
let words: Channel[string] = Channel.new()
go {
  for word in "ants never walk alone".split(" ") {
    words.send(word)
  }
  words.close()
}
for word in words.values() {
  println(word.toUpper())
}

// Nobody sends on quiet, so the timeout wins.
let quiet: Channel[string] = Channel.new()
let patience = Context.new(100ms)
select {
  let message = Channel.receive(quiet) { println("heard ${message ?? "nothing"}") }
  Context.wait(patience) { println("gave up after 100ms") }
}
