// Strings are Unicode text, counted in what a reader sees.

var family = "👨‍👩‍👧"
println(`${family} is ${len(String.graphemes(family))} character`)
println(String.graphemes("🇨🇭🇩🇪"))
println(String.toUpper("straße"))

// Dates are calendar dates: a month after August 31 is September 30.
var date = Time.plainDate(2024, 8, 31)
println(Time.add(date, Time.duration(months: 1)))

var zone = Result.unwrap(Time.zone("Europe/Stockholm"))
var meeting = Time.toZoned(Time.plainDateTime(Time.plainDate(2026, 3, 29), Time.plainTime(hour: 2, minute: 30)), zone)
println(`2:30 does not exist that night in Stockholm: ${meeting}`)
