// Shape is a union of records. `is` tells its members apart, and inside
// the branch the checker knows which one it has.

type Circle = { radius: float64 }
type Rect = { width: float64, height: float64 }
type Triangle = { base: float64, height: float64 }
type Shape = Circle | Rect | Triangle

// No final else: the three branches cover every Shape, and the checker knows it.
// Add a member to Shape, and this function stops checking until you handle it.
func area(s: Shape): float64 {
  if s is Circle { Math.PI * s.radius * s.radius }
  else if s is Rect { s.width * s.height }
  else if s is Triangle { s.base * s.height / 2.0 }
}

func name(s: Shape): string {
  if s is Circle { "circle" } else if s is Rect { "rect" } else { "triangle" }
}

let shapes: Array[Shape] = [
  Circle{ radius: 1.5 },
  Rect{ width: 2.0, height: 3.0 },
  Triangle{ base: 4.0, height: 5.0 },
  Circle{ radius: 0.5 },
]

for s in shapes {
  println("${name(s)}: ${Math.round(area(s) * 100.0) / 100.0}")
}

let largest = shapes.maxBy(area)
if largest is Triangle {
  println("the largest is a triangle with base ${largest.base}")
}
println("${shapes.countWhere({ x is Circle })} of them are circles")
